# Copie este arquivo para ".env" e ajuste. Nunca commite o ".env" de verdade.

# ---------------------------------------------------------------------------
# Qual provedor de IA usar:
#   local  → servidor de modelo no MESMO dispositivo que este backend
#            (PC com Ollama, ou celular com llama.cpp via Termux)
#   remote → servidor de modelo em OUTRO dispositivo da rede local
#            (ex: celular usando o modelo do PC)
#   api    → serviço de IA hospedado na nuvem (OpenAI, Anthropic, OpenRouter...)
# ---------------------------------------------------------------------------
AGNES_PROVIDER=local

# Formato de API que o servidor/serviço de modelo fala:
#   ollama    → API nativa do Ollama (/api/chat) — só faz sentido com local/remote
#   openai    → API compatível com OpenAI (/v1/chat/completions) — llama-server,
#               LM Studio, OpenAI de verdade, OpenRouter, Groq, Together...
#   anthropic → API nativa da Anthropic (/v1/messages) — só faz sentido com "api"
AGNES_LLM_FLAVOR=ollama

# Nome do modelo (ex: "llama3.1" no Ollama, "gpt-4o-mini" ou "claude-sonnet-4-5" numa API)
# IMPORTANTE: tem que bater EXATAMENTE com o nome que aparece em `ollama list`
# (ou `curl http://127.0.0.1:11434/api/tags`) — incluindo a tag depois dos
# dois-pontos, ex: "smollm2:1.7b". Nome errado = erro 404 ao conversar.
AGNES_LLM_MODEL=llama3.1

# --- só usado quando AGNES_PROVIDER=local ---
# Porta do servidor de modelo local (Ollama padrão: 11434; llama-server
# costuma usar 8080 — ajuste conforme o que você estiver rodando)
AGNES_LOCAL_LLM_PORT=11434

# --- só usado quando AGNES_PROVIDER=remote ---
# Host/IP da máquina onde o modelo está rodando (obrigatório nesse modo)
AGNES_REMOTE_HOST=
AGNES_REMOTE_PORT=11434
# true se esse servidor remoto tiver HTTPS configurado (recomendado pra uso
# fora de testes rápidos — veja backend/README.md)
AGNES_REMOTE_HTTPS=false

# --- só usado quando AGNES_PROVIDER=api ---
# NUNCA commite uma chave real aqui — isso fica só no seu .env local,
# que está no .gitignore. O frontend nunca vê essa chave.
AGNES_API_KEY=
# Endpoint base do serviço. Alguns exemplos comuns:
#   OpenAI:      https://api.openai.com          (flavor=openai)
#   Anthropic:   https://api.anthropic.com       (flavor=anthropic)
#   OpenRouter:  https://openrouter.ai/api       (flavor=openai)
#   Groq:        https://api.groq.com/openai     (flavor=openai)
AGNES_API_BASE_URL=https://api.openai.com

# Porta em que ESTE backend (o da Agnes, não o do modelo) roda — usada só
# pela dica impressa ao iniciar
AGNES_PORT=8787

# Origens permitidas a chamar este backend (separadas por vírgula, sem espaço).
# Inclua:
#  - onde você abre o index.html localmente durante o desenvolvimento
#  - a URL do seu GitHub Pages (ex: https://SEU-USUARIO.github.io) — necessário
#    pra usar a Agnes a partir do app hospedado, inclusive do celular
# NÃO inclua origens que não são suas — qualquer uma na lista pode usar seu
# modelo enquanto o backend estiver rodando e alcançável.
AGNES_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080,https://SEU-USUARIO.github.io
